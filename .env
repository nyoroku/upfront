# Worklane Development Environment
# Copy this to .env in the project root

SECRET_KEY=django-insecure-dev-key-worklane-local-development-only-change-in-production
DEBUG=True
ALLOWED_HOSTS=*

# Google OAuth (fill in from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# M-Pesa (sandbox defaults)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:8000/payments/callback/
MPESA_ENV=sandbox

# Redis (optional for dev)
REDIS_URL=redis://localhost:6379/0
